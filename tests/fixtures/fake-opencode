#!/usr/bin/env node
// Fake `opencode` CLI. `opencode models` lists models; `opencode run <prompt> --format json --auto`
// emits JSON lines shaped like the events server.mjs parses (type: text | tool_use | error).
// Shape is a best guess from server.mjs's parser, not a recording (TODO: record real one).
import fs from "node:fs";
const scenario = process.env.FAKE_SCENARIO || "normal";
const argv = process.argv.slice(2);
if (process.env.FAKE_LOG) {
  fs.appendFileSync(process.env.FAKE_LOG, JSON.stringify({ pid: process.pid, argv, cwd: process.cwd(), scenario, bin: "opencode" }) + "\n");
}
const sid = "ses_fakeopencode1";
const out = (o) => process.stdout.write(JSON.stringify({ sessionID: sid, ...o }) + "\n");
if (argv[0] === "models") {
  process.stdout.write("anthropic/claude-haiku\nopenai/gpt-fake\n");
} else if (scenario === "hang") {
  setInterval(() => {}, 1 << 30);
} else if (scenario === "empty") {
  process.exit(0);
} else if (scenario === "partial_then_crash") {
  out({ type: "text", part: { text: "partial " } });
  process.stderr.write("fake-opencode: crash\n");
  process.exit(1);
} else if (scenario === "error") {
  out({ type: "error", error: { data: { message: "provider exploded" } } });
} else {
  out({ type: "tool_use", part: { type: "tool", tool: "read", state: { input: { file_path: "/tmp/x.txt" } } } });
  out({ type: "text", part: { text: "open" } });
  out({ type: "text", part: { text: "code" } });
}
